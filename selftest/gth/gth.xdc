set_property -dict {PACKAGE_PIN T24 IOSTANDARD DIFF_SSTL12} [get_ports sys_clk_p]
set_property -dict {PACKAGE_PIN U24 IOSTANDARD DIFF_SSTL12} [get_ports sys_clk_n]
create_clock -period 5.000 -name sys [get_ports sys_clk_p]
set_property PACKAGE_PIN T7 [get_ports refclk_p]
set_property PACKAGE_PIN T6 [get_ports refclk_n]
create_clock -period 6.400 -name ref [get_ports refclk_p]
set_clock_groups -asynchronous -group [get_clocks -include_generated_clocks sys] -group [get_clocks -include_generated_clocks ref]
set_property -dict {PACKAGE_PIN W21 IOSTANDARD LVCMOS18} [get_ports {led[0]}]
set_property -dict {PACKAGE_PIN AC16 IOSTANDARD LVCMOS18} [get_ports {led[1]}]
set_property BITSTREAM.GENERAL.COMPRESS TRUE [current_design]
