## RK-FH1159 V1.0 (RIGUKE) on ALINX AXAU15 (XCAU15P-2FFVB676I) FMC HPC
## Draft, built from:
##   - RK-FH1159 V1.0 FMC 管脚定义.xls + V1.0 原理图
##   - ALINX AXAU15 User Manual, section 3.4 (FMC pin assignment)
## Not yet verified on hardware. VADJ must be 1.8 V (AXAU15 default); banks 64/65 are 1.8 V.
## Port names follow the RK schematic net names (8T49N241_* renamed CLK8T49_* since HDL names cannot start with a digit).
## GT refclk period constraints are generated by the Video PHY Controller IP, so none are set here.

## ---------------------------------------------------------------------------
## GT reference clocks
## ---------------------------------------------------------------------------
## RX TMDS clock (from TMDS181 OUT_CLK) -> FMC GBTCLK0_M2C (D4/D5) -> GTH Quad 225 MGTREFCLK0
set_property PACKAGE_PIN V7 [get_ports HDMI_RXC_C_P]
set_property PACKAGE_PIN V6 [get_ports HDMI_RXC_C_N]

## TX GT reference (8T49N241 Q2 output) -> FMC GBTCLK1_M2C (B20/B21) -> GTH Quad 226 MGTREFCLK0
## The TX lanes are in Quad 225, so the Video PHY TX refclk must come from the neighbouring quad
## (GTNORTHREFCLK0 / GTSOUTHREFCLK0 - pick whichever Vivado offers for 226 -> 225).
set_property PACKAGE_PIN P7 [get_ports GTX_HDMI_CLK_P]
set_property PACKAGE_PIN P6 [get_ports GTX_HDMI_CLK_N]

## ---------------------------------------------------------------------------
## GT data lanes (location is set by the Video PHY / GT wizard channel LOCs, listed for reference)
##   HDMI RX D0..D2 : FMC DP0..DP2 M2C -> Quad 225 RX0..RX2 (Y2/Y1, V2/V1, T2/T1)
##   HDMI TX D0..D2 : FMC DP0..DP2 C2M -> Quad 225 TX0..TX2 (AA5/AA4, W5/W4, U5/U4)
##   HDMI TX CLK    : FMC DP3 C2M      -> Quad 225 TX3     (R5/R4)
##   FMC DP3 M2C and Quad 226 lanes are unused by this card.
## ---------------------------------------------------------------------------

## ---------------------------------------------------------------------------
## Recovered/reference clock to 8T49N241 CLK0 (100R termination on card) : LA00_CC, bank 65
## ---------------------------------------------------------------------------
set_property PACKAGE_PIN V23 [get_ports HDMI_REF_CLK_P]
set_property PACKAGE_PIN W23 [get_ports HDMI_REF_CLK_N]
set_property IOSTANDARD LVDS [get_ports {HDMI_REF_CLK_P HDMI_REF_CLK_N}]

## ---------------------------------------------------------------------------
## Low-speed control, all LVCMOS18 (card side level-shifted by TXS0108E / TCA9406 to FMC_ADJ)
## ---------------------------------------------------------------------------
# HDMI IN
set_property PACKAGE_PIN N22  [get_ports HDMI_RX_HPD_F]       ;# LA03_N  G10  out : RX hot-plug to source
set_property PACKAGE_PIN N21  [get_ports HDMI_RX_PWR_DET]     ;# LA03_P  G9   in  : source +5V present
set_property PACKAGE_PIN AC17 [get_ports HDMI_RX_SNK_SCL]     ;# LA22_N  G25  io  : RX DDC SCL (EDID slave in FPGA)
set_property PACKAGE_PIN AB17 [get_ports HDMI_RX_SNK_SDA]     ;# LA22_P  G24  io  : RX DDC SDA
# HDMI OUT
set_property PACKAGE_PIN R20  [get_ports HDMI_TX_EN_F]        ;# LA08_P  G12  out : SN65DP159 OE
set_property PACKAGE_PIN R21  [get_ports HDMI_TX_SRC_SCL_F]   ;# LA08_N  G13  io  : TX DDC SCL (read monitor EDID)
set_property PACKAGE_PIN R22  [get_ports HDMI_TX_SRC_SDA_F]   ;# LA12_P  G15  io  : TX DDC SDA
set_property PACKAGE_PIN AA22 [get_ports TX_HPD_SRC_F]        ;# LA25_P  G27  in  : monitor hot-plug
set_property PACKAGE_PIN AB22 [get_ports HDMI_TX_CEC]         ;# LA25_N  G28  out : CEC (via AO3400)
# Shared control I2C: SN65DP159 + TMDS181 + 8T49N241 + M24C64
set_property PACKAGE_PIN U21  [get_ports HDMI_CTL_SCL_F]      ;# LA16_P  G18  io
set_property PACKAGE_PIN R23  [get_ports HDMI_CTL_SDA_F]      ;# LA12_N  G16  io
# 8T49N241
set_property PACKAGE_PIN AF17 [get_ports CLK8T49_RST]        ;# LA20_N  G22  out
set_property PACKAGE_PIN AE17 [get_ports CLK8T49_INT]        ;# LA20_P  G21  in
set_property PACKAGE_PIN U22  [get_ports CLK8T49_LOL]        ;# LA16_N  G19  in

set_property IOSTANDARD LVCMOS18 [get_ports {HDMI_RX_HPD_F HDMI_RX_PWR_DET HDMI_RX_SNK_SCL HDMI_RX_SNK_SDA \
    HDMI_TX_EN_F HDMI_TX_SRC_SCL_F HDMI_TX_SRC_SDA_F TX_HPD_SRC_F HDMI_TX_CEC \
    HDMI_CTL_SCL_F HDMI_CTL_SDA_F CLK8T49_RST CLK8T49_INT CLK8T49_LOL}]
