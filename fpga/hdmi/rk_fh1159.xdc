# rk_fh1159: pins from constraints/ (see there for the FMC names)
set_property PACKAGE_PIN Y2 [get_ports {HDMI_RX_DAT_P_IN[0]}]
set_property PACKAGE_PIN V2 [get_ports {HDMI_RX_DAT_P_IN[1]}]
set_property PACKAGE_PIN T2 [get_ports {HDMI_RX_DAT_P_IN[2]}]
set_property PACKAGE_PIN V7 [get_ports HDMI_RX_CLK_P_IN]
set_property PACKAGE_PIN V23 [get_ports RX_REFCLK_P_OUT]
set_property IOSTANDARD LVDS [get_ports RX_REFCLK_P_OUT]
set_property PACKAGE_PIN N21 [get_ports {RX_DET_IN}]
set_property PACKAGE_PIN N22 [get_ports {RX_HPD_OUT}]
set_property PACKAGE_PIN R20 [get_ports {TX_EN_OUT_tri_o[0]}]
set_property PACKAGE_PIN AF17 [get_ports {TX_EN_OUT_tri_o[1]}]
set_property PACKAGE_PIN U21 [get_ports {iic_dp159_scl_io}]
set_property PACKAGE_PIN R23 [get_ports {iic_dp159_sda_io}]
set_property PACKAGE_PIN AC17 [get_ports {RX_DDC_OUT_scl_io}]
set_property PACKAGE_PIN AB17 [get_ports {RX_DDC_OUT_sda_io}]
set_property IOSTANDARD LVCMOS18 [get_ports {RX_DET_IN RX_HPD_OUT {TX_EN_OUT_tri_o[*]} iic_dp159_scl_io iic_dp159_sda_io RX_DDC_OUT_scl_io RX_DDC_OUT_sda_io}]
set_property DRIVE 12 [get_ports {RX_HPD_OUT {TX_EN_OUT_tri_o[*]}}]
set_property SLEW SLOW [get_ports {iic_dp159_scl_io iic_dp159_sda_io RX_DDC_OUT_scl_io RX_DDC_OUT_sda_io}]
set_property PULLTYPE PULLUP [get_ports {iic_dp159_scl_io iic_dp159_sda_io}]
# transmitter (loopback tests); lanes are placed by the Video PHY (X0Y4..X0Y7: AA5, W5, U5 data, R5 TMDS clock)
set_property PACKAGE_PIN P7 [get_ports TX_REFCLK_P_IN]
set_property PACKAGE_PIN AA22 [get_ports TX_HPD_IN]
set_property PACKAGE_PIN U22 [get_ports IDT_LOL_IN]
set_property PACKAGE_PIN R21 [get_ports TX_DDC_OUT_scl_io]
set_property PACKAGE_PIN R22 [get_ports TX_DDC_OUT_sda_io]
set_property IOSTANDARD LVCMOS18 [get_ports {TX_HPD_IN IDT_LOL_IN TX_DDC_OUT_scl_io TX_DDC_OUT_sda_io}]
set_property SLEW SLOW [get_ports {TX_DDC_OUT_scl_io TX_DDC_OUT_sda_io}]
set_property PULLTYPE PULLUP [get_ports {TX_DDC_OUT_scl_io TX_DDC_OUT_sda_io}]
