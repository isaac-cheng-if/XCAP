set_property PACKAGE_PIN T19 [get_ports pcie_rstn]
set_property IOSTANDARD LVCMOS18 [get_ports pcie_rstn]
set_property PULLTYPE PULLUP [get_ports pcie_rstn]
set_property PACKAGE_PIN AB7 [get_ports pcie_ref_clk_p]
create_clock -period 10.000 -name pcie_ref_clk [get_ports pcie_ref_clk_p]
set_property PACKAGE_PIN AF2 [get_ports {pcie_mgt_rxp[3]}]
set_property PACKAGE_PIN AF7 [get_ports {pcie_mgt_txp[3]}]
set_property PACKAGE_PIN AE4 [get_ports {pcie_mgt_rxp[2]}]
set_property PACKAGE_PIN AE9 [get_ports {pcie_mgt_txp[2]}]
set_property PACKAGE_PIN AD2 [get_ports {pcie_mgt_rxp[1]}]
set_property PACKAGE_PIN AD7 [get_ports {pcie_mgt_txp[1]}]
set_property PACKAGE_PIN AB2 [get_ports {pcie_mgt_rxp[0]}]
set_property PACKAGE_PIN AC5 [get_ports {pcie_mgt_txp[0]}]
set_property PACKAGE_PIN T24 [get_ports clk_200m_p]
set_property PACKAGE_PIN U24 [get_ports clk_200m_n]
set_property IOSTANDARD DIFF_SSTL12 [get_ports {clk_200m_p clk_200m_n}]
create_clock -period 5.000 -name clk_200m [get_ports clk_200m_p]
set_property PACKAGE_PIN AC16 [get_ports led]
set_property IOSTANDARD LVCMOS18 [get_ports led]
set_property BITSTREAM.GENERAL.COMPRESS TRUE [current_design]
set_property BITSTREAM.CONFIG.CONFIGRATE 85.0 [current_design]
set_property BITSTREAM.CONFIG.SPI_BUSWIDTH 4 [current_design]
set_property BITSTREAM.CONFIG.UNUSEDPIN PULLNONE [current_design]
set_false_path -from [get_ports pcie_rstn]
set_false_path -to [get_ports led]
set_property PACKAGE_PIN A12 [get_ports uart_rx]
set_property PACKAGE_PIN A13 [get_ports uart_tx]
set_property IOSTANDARD LVCMOS33 [get_ports {uart_rx uart_tx}]
# quasi-static configuration and frame-stable values crossing between the PCIe and video clocks
set_max_delay -datapath_only 6.0 -from [get_cells -hier -regexp {.*u_regs/cfg_.*_reg.*}] -to [get_clocks -of_objects [get_pins u_mmcm/CLKOUT0]]
set_max_delay -datapath_only 6.0 -from [get_cells -hier -regexp {.*u_framer/vpic_reg.*}] -to [get_cells -hier -regexp {.*u_framer/a_pic_a_reg.*}]
set_max_delay -datapath_only 8.0 -from [get_cells -hier -regexp {.*u_meta/cfg_snap_reg.*}] -to [get_cells -hier -regexp {.*u_meta/meta_reg.*}]
set_max_delay -datapath_only 8.0 -from [get_cells -hier -regexp {.*u_regs/host_ctrl_reg.*}] -to [get_cells -hier -regexp {.*u_meta/hc_a_reg.*}]
# longest TMDS clock the PHY reference input sees (4K60 runs it at 148.5 MHz; 297 MHz is the ceiling without scrambling)
create_clock -period 3.367 -name hdmi_rx_clk [get_ports HDMI_RX_CLK_P_IN]
set_false_path -from [get_ports {TX_HPD_IN IDT_LOL_IN TX_DDC_OUT_scl_io TX_DDC_OUT_sda_io RX_DET_IN RX_DDC_OUT_scl_io RX_DDC_OUT_sda_io iic_dp159_scl_io iic_dp159_sda_io uart_rx}]
set_false_path -to [get_ports {TX_DDC_OUT_scl_io TX_DDC_OUT_sda_io RX_HPD_OUT TX_EN_OUT_tri_o[*] RX_DDC_OUT_scl_io RX_DDC_OUT_sda_io iic_dp159_scl_io iic_dp159_sda_io uart_tx}]
set_max_delay -datapath_only 8.0 -from [get_cells -hier -regexp {.*u_regs/cfg_tpg_audio_reg.*}] -to [get_cells -hier -regexp {.*u_audio/rate_a_reg.*}]
# TX reference from the clock chip, at most 297 MHz
create_clock -period 3.367 -name hdmi_tx_ref [get_ports TX_REFCLK_P_IN]
# firmware-set audio and ACR values, quasi-static: an exception only where they leave the MicroBlaze clock for a clock
# of the HDMI side. Paths inside the 100 MHz clock (m0: test sound, loop-out sound switch, register read-back) and to
# the synchronous 300 MHz clock (v0: loop-out enable, through its xpm_cdc) are timed like any other.
set_max_delay -datapath_only 8.0 -from [get_cells -hier -regexp {.*u_meta/aud_(n|cts|rate|cfg)_reg.*}] -to [get_clocks -filter {NAME != m0 && NAME != v0}]
set_max_delay -datapath_only 8.0 -from [get_cells -hier -regexp {.*u_regs/tx_ctrl_reg.*}] -to [get_cells -hier -regexp {.*u_meta/tc_a_reg.*}]
